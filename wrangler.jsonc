{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auctionarena",
  "main": "apps/api/src/worker/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDurableObject"
      },
      {
        "name": "DIRECTORY",
        "class_name": "DirectoryDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DirectoryDurableObject"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "auctionarena-staging",
      // Public values only. Secrets are set with `wrangler secret put`.
      "vars": {
        "CLERK_ISSUER": "https://quality-labrador-8216.clerk.accounts.dev",
        "ALLOWED_ORIGINS": "https://auctionarena-staging.palligopi1924.workers.dev"
      },
      // Wrangler does not inherit Durable Object bindings into environments,
      // so staging declares the same classes. Migrations are inherited.
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOM",
            "class_name": "RoomDurableObject"
          },
          {
            "name": "DIRECTORY",
            "class_name": "DirectoryDurableObject"
          }
        ]
      }
    }
  }
}
