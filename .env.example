# Browser public key only; never put a Clerk secret in VITE_* variables.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless Clerk session verification.
CLERK_JWT_KEY=
# dev:clerk derives this from the publishable key; direct API runs may set it.
CLERK_ISSUER=
WEB_PORT=5173
LOCAL_DEV_AUTH=false
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_FILE=.data/auctionarena.json
AWS_REGION=ap-southeast-2
AWS_PROFILE=AUCTION-FIELD
